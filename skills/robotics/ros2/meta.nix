{
  name = "ros2";
  description = "Best practices, design patterns, and common pitfalls for ROS2 development. Use when building or debugging ROS2 nodes, packages, launch files, or components — including QoS, lifecycle/managed nodes, actions, parameters, intra-process comms, DDS tuning, executors, and custom message generation. Also covers colcon/ament build troubleshooting, package.xml and CMakeLists.txt dependencies, workspace overlays, nav2, MoveIt2, and micro-ROS. Covers Humble (LTS, EOL May 2027), Jazzy (LTS, EOL May 2029 — recommended for greenfield), Kilted (non-LTS), and Rolling; Iron Irwini is EOL.";
}
