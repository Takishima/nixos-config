{
  name = "ros2-web-integration";
  description = "Patterns for integrating ROS2 with web technologies: REST APIs over ROS2 services, rosbridge/roslibjs WebSocket bridges, MJPEG and WebRTC camera streaming, and browser-based robot dashboards. Use when building a web UI for a robot, streaming camera feeds to a browser, exposing ROS2 services as REST endpoints (FastAPI/Flask with rclpy), running an async web framework alongside the ROS2 executor, or handling auth, CORS, and rate-limiting on robot web interfaces. Covers rosbridge_suite, FastAPI, Flask, WebSocket, and WebRTC on Humble, Jazzy (recommended), Kilted, and Rolling; Iron is EOL.";
}
