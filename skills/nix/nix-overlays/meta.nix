{
  name = "nix-overlays";
  description = "Add, override, or patch nixpkgs packages via overlays. Use when adding a package to an existing pkgs set, modifying an upstream package's args/attrs/patches, or composing reusable nixpkgs modifications. Covers the prev/final rule, scoped overlays (Python/Haskell/Lua), composition, and common slow-eval pitfalls.";
  allowedTools = "Read, Write, Edit, Glob, Grep, Bash, mcp__rime__nix_evaluate, mcp__rime__nix_packages_search";
}
